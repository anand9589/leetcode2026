<UserControl x:Class="WpfApp1.UserControl1"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WpfApp1"
             mc:Ignorable="d" 
             d:DesignHeight="50" d:DesignWidth="50">
    <UserControl.Resources>
        <local:NumberToVisibilityConverter x:Key="NumberToVisibilityConverter"></local:NumberToVisibilityConverter>
        <Style TargetType="Label">
            <Setter Property="Margin" Value="1"></Setter>
            <Setter Property="Padding" Value="1"></Setter>
        </Style>
    </UserControl.Resources>
    <Border BorderBrush="Black" BorderThickness="1">
        
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <Label  Visibility="{Binding VisibleNumbers, Converter={StaticResource NumberToVisibilityConverter}, ConverterParameter=1}">1</Label>
            <Label  Visibility="{Binding VisibleNumbers, Converter={StaticResource NumberToVisibilityConverter}, ConverterParameter=2}" Grid.Column="1" >2</Label>
            <Label  Visibility="{Binding VisibleNumbers, Converter={StaticResource NumberToVisibilityConverter}, ConverterParameter=3}" Grid.Column="2">3</Label>
            <Label  Visibility="{Binding VisibleNumbers, Converter={StaticResource NumberToVisibilityConverter}, ConverterParameter=4}" Grid.Row="1">4</Label>
            <Label  Visibility="{Binding VisibleNumbers, Converter={StaticResource NumberToVisibilityConverter}, ConverterParameter=5}" Grid.Row="1" Grid.Column="1">5</Label>
            <Label  Visibility="{Binding VisibleNumbers, Converter={StaticResource NumberToVisibilityConverter}, ConverterParameter=6}" Grid.Row="1" Grid.Column="2">6</Label>
            <Label  Visibility="{Binding VisibleNumbers, Converter={StaticResource NumberToVisibilityConverter}, ConverterParameter=7}" Grid.Row="2">7</Label>
            <Label  Visibility="{Binding VisibleNumbers, Converter={StaticResource NumberToVisibilityConverter}, ConverterParameter=8}" Grid.Row="2" Grid.Column="1">8</Label>
            <Label  Visibility="{Binding VisibleNumbers, Converter={StaticResource NumberToVisibilityConverter}, ConverterParameter=9}" Grid.Row="2" Grid.Column="2">9</Label>

            <TextBox TextChanged="TextBox_TextChanged" Grid.ColumnSpan="3" Grid.RowSpan="3" Background="Transparent" HorizontalAlignment="Center" VerticalAlignment="Center" Width="40" Height="40" BorderThickness="0" FontSize="30" FontWeight="Bold"></TextBox>
        </Grid>
    </Border>
</UserControl>
